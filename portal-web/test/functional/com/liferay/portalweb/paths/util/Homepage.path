<html>
<head>
<title>Homepage</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">Homepage</td></tr>
</thead>

<tbody>
<tr>
	<td>USER_PROFILE_MENU</td>
	<td>//div[contains(@class,'personal-menu-dropdown lfr-tooltip-scope')]/div/button/span</td>
	<td></td>
</tr>
<tr>
	<td>USER_NAME</td>
	<td>//div[contains(@class,'dropdown-menu-personal-menu') and contains(@class,'show')]//li[@id='clay-dropdown-menu-group-1']</td>
	<td></td>
</tr>
<tr>
	<td>PAGE_HEADING</td>
	<td>//h1[contains(@class,'component-heading mb-0 text-break')]</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>